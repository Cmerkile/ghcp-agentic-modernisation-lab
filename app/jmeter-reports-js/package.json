{
  "name": "jmeter-reports-js",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Single-user JMeter .jtl report application: Express + SQLite API and React (JavaScript) UI.",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "setup": "npm --prefix server install && npm --prefix client install",
    "dev": "node scripts/dev.js",
    "start": "node scripts/dev.js",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "lint": "npm --prefix client run lint",
    "test": "npm --prefix server test",
    "seed": "node scripts/seed.js",
    "reset": "node scripts/seed.js --reset"
  }
}
